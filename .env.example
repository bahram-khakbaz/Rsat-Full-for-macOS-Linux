JWT_SECRET=replace-with-a-long-random-secret
# Protects stored AD/SSH/worker credentials. Leave empty on an installation that
# predates this setting until you are ready to rotate (see docs/SECURITY.md).
ENCRYPTION_KEY=replace-with-a-separate-random-encryption-key
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
DEMO_MODE=true
POSTGRES_DB=rsat
POSTGRES_USER=rsat
POSTGRES_PASSWORD=replace-with-a-long-random-db-password
DATABASE_URL=postgresql+psycopg://rsat:replace-with-a-long-random-db-password@db:5432/rsat
WORKER_URL=
WORKER_TOKEN=
# Only for an isolated lab segment: allows an http:// worker URL.
ALLOW_INSECURE_WORKER=false
