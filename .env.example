JWT_SECRET=replace-with-a-long-random-secret
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
DEMO_MODE=true
POSTGRES_DB=rsat
POSTGRES_USER=rsat
POSTGRES_PASSWORD=replace-with-a-long-random-db-password
