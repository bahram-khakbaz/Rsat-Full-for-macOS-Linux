AGENT_TOKEN=__AUTO_GENERATED__
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8765
POWERSHELL_EXE=powershell.exe

# TLS is on by default. Without these two files the worker creates and reuses a
# self-signed certificate under worker-state\tls and prints its SHA-256 fingerprint.
#TLS_CERT_FILE=C:\path\to\worker-cert.pem
#TLS_KEY_FILE=C:\path\to\worker-key.pem
# Extra DNS names or IP addresses for the generated certificate, comma-separated.
#TLS_SAN=rsat-worker.example.com
# Lab only: serve unencrypted HTTP. The control plane refuses it unless told otherwise.
#ALLOW_INSECURE_HTTP=false

# GPO backups are written only below this directory (default %ProgramData%\RSATFull\GpoBackups).
#GPO_BACKUP_ROOT=D:\GpoBackups
# Unpaged inventories larger than this fail explicitly instead of being cut short.
#MAX_UNPAGED_RESULTS=5000
